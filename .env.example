# =============================================================================
# SAFARNAMA ENVIRONMENT CONFIGURATION (.env.example)
# Copy this template to .env and supply your local API keys.
# Never commit real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM & Fallback Estimator API Keys
# -----------------------------------------------------------------------------
# Google Gemini API key (Primary LLM & Fallback Estimator Tier 1)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Groq API Key (Fallback Estimator Tier 2 - Fast LPU Inference)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM API Key (Fallback Estimator Tier 3 - Hosted Open Models)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# Dedicated fallback LLM overrides (optional)
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# -----------------------------------------------------------------------------
# 2. Visa Rule Enrichment Credentials
# -----------------------------------------------------------------------------
# Dedicated key for visa rules synthesis (scripts/enrich_visa_rules.py)
GEMINI_ENRICHMENT_API_KEY=
GEMINI_ENRICHMENT_MODEL=gemini-2.5-flash-lite

# Dedicated Tavily key for visa rules web research (scripts/enrich_visa_rules.py)
TAVILY_VISA_ENRICHMENT_API_KEY=

# -----------------------------------------------------------------------------
# 3. Web Search & Scraping Services
# -----------------------------------------------------------------------------
# General Tavily search key for runtime planning tools (src/tools/web_search.py)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=

# Optional: Firecrawl Search API key (src/tools/web_search.py)
# Get your API key at: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# 4. Travel, Hotels & Transport APIs
# -----------------------------------------------------------------------------
# SerpApi Key for Google Hotels and Google Maps Places/Dining discovery
# (src/tools/hotels.py, src/tools/places.py)
# Get your API key at: https://serpapi.com/
SERPAPI_KEY=

# RapidAPI Key for multi-modal travel endpoints (Sky Scraper flights, Flights Sky, IRCTC trains)
# (src/tools/transport.py, src/tools/hotels.py)
# Get your API key at: https://rapidapi.com/
RAPIDAPI_KEY=

# Optional: AviationStack API key for flight schedule data
# Get your API key at: https://aviationstack.com/
AVIATIONSTACK_API_KEY=

# REST Countries v5 API for sovereign country metadata ingestion (scripts/fetch_country_profiles.py)
# Get your API key at: https://restcountries.com/
REST_COUNTRIES_API_KEY=

# -----------------------------------------------------------------------------
# 5. Weather & Currency Forex APIs
# -----------------------------------------------------------------------------
# Optional: OpenWeatherMap API key (src/tools/weather.py)
# If omitted, Open-Meteo, wttr.in, and climate baseline are used automatically.
OPENWEATHERMAP_API_KEY=

# Optional: ExchangeRate-API key (src/tools/forex.py)
# If omitted, open access endpoint (open.er-api.com) and offline rates are used automatically.
EXCHANGERATE_API_KEY=

# -----------------------------------------------------------------------------
# 6. Global Configuration & Feature Flags
# -----------------------------------------------------------------------------
# When set to true, forces all tools to use offline mock fixtures from data/fixtures/
SAFARNAMA_USE_FIXTURES=false
