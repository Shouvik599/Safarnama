# Copy this file to .env and fill in values locally.
# Never commit .env or real secrets.

# Primary planning LLM (Google Gemini)
GOOGLE_API_KEY=

# Dedicated fallback LLM used only for numerical estimates
# when live travel providers cannot supply data.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Visa rule on-demand enrichment (scripts/enrich_visa_rules.py)
# Uses Gemini with native Google Search grounding to enrich static visa records.
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_ENRICHMENT_API_KEY=
# Optional: override the enrichment model (default: gemini-2.0-flash-lite)
GEMINI_ENRICHMENT_MODEL=

# Dedicated Tavily key for visa rules enrichment (scripts/enrich_visa_rules.py)
TAVILY_VISA_ENRICHMENT_API_KEY=

# General Tavily search key for runtime planning agents
TAVILY_API_KEY=

# Optional: Firecrawl Search API key (src/tools/web_search.py).
# If omitted, Tavily, DuckDuckGo open access, and offline fixture are used automatically.
FIRECRAWL_API_KEY=

# REST Countries v5 API (scripts/fetch_country_profiles.py)
# Get your free API key (1,000 requests/month) at: https://restcountries.com/sign-up
REST_COUNTRIES_API_KEY=

# Optional: ExchangeRate-API key (src/tools/forex.py).
# If omitted, open access endpoint (open.er-api.com) and offline baseline are used automatically.
EXCHANGERATE_API_KEY=

# Optional: OpenWeatherMap API key (src/tools/weather.py).
# If omitted, Open-Meteo (open-meteo.com), wttr.in, and climate baseline are used automatically.
OPENWEATHERMAP_API_KEY=

# Optional: force fixture-backed tools during local development
SAFARNAMA_USE_FIXTURES=false

